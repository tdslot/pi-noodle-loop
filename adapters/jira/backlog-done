#!/usr/bin/env bash
# $1: issue key. Targets status NOODLE_JIRA_DONE (default "Done"), not a transition name.
set -euo pipefail
# A prior attempt may have applied remotely before local checkpointing.
state=$(curl -fsS -u "$JIRA_EMAIL:$JIRA_TOKEN" "$JIRA_URL/rest/api/3/issue/$1?fields=status" | jq -er '.fields.status.name')
[ "$state" != "${NOODLE_JIRA_DONE:-Done}" ] || exit 0
api="$JIRA_URL/rest/api/3/issue/$1/transitions"
tid=$(curl -fsS -u "$JIRA_EMAIL:$JIRA_TOKEN" "$api" |
  jq -r --arg n "${NOODLE_JIRA_DONE:-Done}" '[.transitions[] | select(.to.name == $n)][0].id // empty')
[ -n "$tid" ] || { echo "no transition '${NOODLE_JIRA_DONE:-Done}' for $1" >&2; exit 1; }
jq -n --arg id "$tid" '{transition: {id: $id}}' |
  curl -fsS -u "$JIRA_EMAIL:$JIRA_TOKEN" -H 'Content-Type: application/json' -X POST --data @- "$api"
